import { MetadataRoute } from "next";

const SITE_URL = "https://pdflovers-rouge.vercel.app";

export default function sitemap(): MetadataRoute.Sitemap {
  // تمام 42 ٹولز کے پاتھ (Slugs)
  const toolSlugs = [
    "merge-pdf",
    "split-pdf",
    "compress-pdf",
    "pdf-to-word",
    "word-to-pdf",
    "pdf-to-excel",
    "excel-to-pdf",
    "pdf-to-jpg",
    "jpg-to-pdf",
    "pdf-to-powerpoint",
    "powerpoint-to-pdf",
    "protect-pdf",
    "unlock-pdf",
    "rotate-pdf",
    "ocr-pdf",
    "page-numbers",
    "watermark-pdf",
    "crop-pdf",
    "organize-pdf",
    "redact-pdf",
    "sign-pdf",
    "repair-pdf",
    "flatten-pdf",
    "compare-pdf",
    "extract-images",
    "extract-text",
    "pdf-to-pdfa",
    "html-to-pdf",
    "txt-to-pdf",
    "svg-to-pdf",
    "heic-to-pdf",
    "png-to-pdf",
    "bmp-to-pdf",
    "tiff-to-pdf",
    "pdf-to-png",
    "pdf-to-txt",
    "pdf-to-csv",
    "pdf-to-html",
    "pdf-to-epub",
    "epub-to-pdf",
    "summarize-pdf",
    "chat-pdf"
  ];

  const currentDate = new Date();

  // 42 ٹولز کے ڈائنامک میپنگ والے URLs
  const toolEntries: MetadataRoute.Sitemap = toolSlugs.map((slug) => ({
    url: `${SITE_URL}/${slug}`,
    lastModified: currentDate,
    changeFrequency: "weekly",
    priority: 0.9,
  }));

  // مین پیج اور قانونی صفحات
  const staticEntries: MetadataRoute.Sitemap = [
    {
      url: SITE_URL,
      lastModified: currentDate,
      changeFrequency: "daily",
      priority: 1.0,
    },
    {
      url: `${SITE_URL}/about`,
      lastModified: currentDate,
      changeFrequency: "monthly",
      priority: 0.5,
    },
    {
      url: `${SITE_URL}/contact`,
      lastModified: currentDate,
      changeFrequency: "monthly",
      priority: 0.5,
    },
    {
      url: `${SITE_URL}/privacy-policy`,
      lastModified: currentDate,
      changeFrequency: "monthly",
      priority: 0.3,
    },
    {
      url: `${SITE_URL}/terms`,
      lastModified: currentDate,
      changeFrequency: "monthly",
      priority: 0.3,
    },
    {
      url: `${SITE_URL}/disclaimer`,
      lastModified: currentDate,
      changeFrequency: "monthly",
      priority: 0.3,
    },
  ];

  return [...staticEntries, ...toolEntries];
}
